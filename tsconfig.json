{
  "compilerOptions": {
    "module": "CommonJS",        
    "moduleResolution": "node",  
    "target": "ES2020",
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}